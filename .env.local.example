# ─── Supabase ────────────────────────────────────────────────────────────────
# https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Upstash Redis ───────────────────────────────────────────────────────────
# https://console.upstash.com → Create Database → REST API
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# ─── Groq ────────────────────────────────────────────────────────────────────
# https://console.groq.com → API Keys
GROQ_API_KEY=gsk_your-key-here

# ─── Vapi ────────────────────────────────────────────────────────────────────
# https://dashboard.vapi.ai → Account → API Keys
VAPI_API_KEY=your-vapi-key
VAPI_ASSISTANT_ID=your-assistant-id

# ─── Twilio (optional — SMS nurture pipeline) ────────────────────────────────
# https://console.twilio.com → Account Info
# Leave empty to run in mock/log mode (no real SMS sent)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ─── Tenant ──────────────────────────────────────────────────────────────────
# UUID from the tenants table (run: SELECT id FROM tenants WHERE slug = 'your-slug')
TENANT_ID=your-tenant-uuid

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# On Vercel: set to https://your-app.vercel.app
